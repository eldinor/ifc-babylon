{
  "name": "babylon-ifc-loader",
  "version": "2.2.1",
  "description": "Babylon.js Loader for IFC files using web-ifc",
  "type": "module",
  "main": "dist-npm/index.js",
  "module": "dist-npm/index.js",
  "types": "dist-npm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-npm/index.js",
      "types": "./dist-npm/index.d.ts"
    }
  },
  "files": [
    "dist-npm",
    "LICENSE",
    "CHANGELOG.md",
    "readme.md",
    "API.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && vite --force",
    "build": "vite build",
    "build:npm": "tsc --project tsconfig.build.json && npm run fix:worker-path && npm run copy:wasm && npm run prune:dist",
    "fix:worker-path": "node -e \"const fs=require('fs');const p='dist-npm/ifcWorkerClient.js';const s=fs.readFileSync(p,'utf8');fs.writeFileSync(p,s.replace('./ifc.worker.ts','./ifc.worker.js'));\"",
    "copy:wasm": "node -e \"require('fs').cpSync('node_modules/web-ifc/web-ifc.wasm', 'dist-npm/web-ifc.wasm')\"",
    "prune:dist": "node -e \"const fs=require('fs');['dist-npm/web-ifc-api.js','dist-npm/web-ifc-mt.wasm','dist-npm/web-ifc-mt.worker.js'].forEach(p=>{if(fs.existsSync(p))fs.rmSync(p,{force:true});});\"",
    "build:all": "npm run build && npm run build:npm",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "ifc",
    "bim",
    "babylonjs",
    "babylon.js",
    "3d",
    "viewer",
    "web-ifc",
    "loader",
    "scene-loader"
  ],
  "author": {
    "name": "Andrei Stepanov",
    "email": "eldinor@gmail.com",
    "url": "https://babylonpress.org/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldinor/ifc-babylon.git"
  },
  "bugs": {
    "url": "https://github.com/eldinor/ifc-babylon/issues"
  },
  "homepage": "https://github.com/eldinor/ifc-babylon#readme",
  "dependencies": {
    "@babylonjs/core": "^8.52.0",
    "web-ifc": "^0.0.75"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^8.52.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.0.18"
  }
}
