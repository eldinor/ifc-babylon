{
  "name": "babylon-ifc-loader",
  "version": "1.0.2",
  "description": "Babylon.js SceneLoader plugin for IFC files using web-ifc",
  "type": "module",
  "main": "dist-npm/index.js",
  "module": "dist-npm/index.js",
  "types": "dist-npm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-npm/index.js",
      "types": "./dist-npm/index.d.ts"
    }
  },
  "files": [
    "dist-npm",
    "LICENSE",
    "readme.md",
    "API.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:npm": "tsc --project tsconfig.build.json && npm run copy:wasm",
    "copy:wasm": "node -e \"require('fs').cpSync('node_modules/web-ifc/web-ifc.wasm', 'dist-npm/web-ifc.wasm')\"",
    "build:all": "npm run build && npm run build:npm",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "ifc",
    "bim",
    "babylonjs",
    "babylon.js",
    "3d",
    "viewer",
    "web-ifc",
    "loader",
    "scene-loader"
  ],
  "author": {
    "name": "Andrei Stepanov",
    "email": "eldinor@gmail.com",
    "url": "https://babylonpress.org/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldinor/ifc-babylon.git"
  },
  "bugs": {
    "url": "https://github.com/eldinor/ifc-babylon/issues"
  },
  "homepage": "https://github.com/eldinor/ifc-babylon#readme",
  "dependencies": {
    "@babylonjs/core": "^8.52.0",
    "web-ifc": "^0.0.75"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^8.52.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.0.18"
  }
}
